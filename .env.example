# Copier ce fichier en `.env` puis adapter les valeurs. `.env` n'est jamais commité.

# Base MySQL applicative (voir scripts/init-db.sql)
DATABASE_URL="mysql://greentrek:change-moi@localhost:3306/greentrek"
# Base « shadow » utilisée par `prisma migrate dev`
SHADOW_DATABASE_URL="mysql://greentrek:change-moi@localhost:3306/greentrek_shadow"
# Base des tests d'intégration (vidée par `npm test`)
TEST_DATABASE_URL="mysql://greentrek:change-moi@localhost:3306/greentrek_test"

# Secret Auth.js (signature et chiffrement du cookie de session) : générer avec `openssl rand -base64 32`
AUTH_SECRET="a-remplacer"

# Développement uniquement : origines supplémentaires autorisées (ex. IP du poste pour tester
# sur téléphone), séparées par des virgules. Laisser vide si inutile.
ALLOWED_DEV_ORIGINS=""

# Adresse publique utilisée dans le QR code des factures (facultatif). Un téléphone ne peut
# pas ouvrir « localhost » : pour la démonstration, mettre l'adresse de l'ordinateur sur le
# Wi-Fi, par exemple http://192.168.0.101:3000 (voir aussi ALLOWED_DEV_ORIGINS).
PUBLIC_BASE_URL=""
