# Copier ce fichier en `.env` puis adapter les valeurs. `.env` n'est jamais commité.

# Base MySQL applicative (voir scripts/init-db.sql)
DATABASE_URL="mysql://greentrek:change-moi@localhost:3306/greentrek"
# Base « shadow » utilisée par `prisma migrate dev`
SHADOW_DATABASE_URL="mysql://greentrek:change-moi@localhost:3306/greentrek_shadow"
# Base des tests d'intégration (vidée par `npm test`)
TEST_DATABASE_URL="mysql://greentrek:change-moi@localhost:3306/greentrek_test"

# Secret Auth.js (étape E2) : générer avec `openssl rand -base64 32`
AUTH_SECRET="a-remplacer"
