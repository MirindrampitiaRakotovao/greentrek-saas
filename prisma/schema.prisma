// Schéma Prisma de Green Trek SaaS (cahier des charges §5, 19 tables).
//
// Conventions :
// - Modèles et champs en français sans accents, comme dans le mémoire.
// - Identifiants `cuid()` : non devinables dans les URL (défense en profondeur).
// - Montants en `Int` (Ariary, pas de centimes en usage).
// - Distances et coordonnées en `Float` (double précision).
// - Multi-tenant : toute table métier porte `agenceId` (indexé). Les tables de liaison
//   (CircuitEtape, CircuitPartenaire, Participant, Paiement) héritent de l'agence de leur parent.
// - Contraintes CHECK : ajoutées à la main dans la migration SQL (Prisma ne sait pas les
//   déclarer). Les relations sur les colonnes concernées utilisent `onUpdate: Restrict`,
//   car MySQL interdit une action référentielle en cascade sur une colonne soumise à un CHECK.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ─── Énumérations ──────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN_AGENCE
  STAFF
  GUIDE
  CLIENT
}

enum StatutAgence {
  ACTIVE
  SUSPENDUE
}

enum DifficulteCircuit {
  FACILE
  MOYENNE
  DIFFICILE
}

enum StatutCircuit {
  BROUILLON
  PUBLIE
  ARCHIVE
}

enum TypeEtape {
  VILLAGE
  POINT_INTERET
  HEBERGEMENT
  RESTAURATION
  EMBARCADERE
  AUTRE
}

enum StatutSession {
  OUVERTE
  COMPLETE
  ANNULEE
  TERMINEE
}

enum StatutReservation {
  EN_ATTENTE
  CONFIRMEE
  ANNULEE
  TERMINEE
}

enum TypePartenaire {
  HEBERGEMENT
  RESTAURATION
  ACTIVITE
  TRANSPORT
}

enum MethodePaiement {
  ESPECES
  MOBILE_MONEY
  VIREMENT
  CARTE_SIMULEE
}

enum StatutPaiement {
  EN_ATTENTE
  VALIDE
  ECHOUE
  REMBOURSE
}

enum Algorithme {
  DIJKSTRA
  ASTAR
}

enum CritereItineraire {
  PLUS_COURT
  PLUS_RAPIDE
  PLUS_FACILE
  PERSONNALISE
}

enum StatutAbonnement {
  ESSAI
  ACTIF
  EXPIRE
  ANNULE
}

enum StatutAvis {
  EN_ATTENTE
  PUBLIE
  REJETE
}

// ─── 1. Agence (tenant racine) ─────────────────────────────────────────────────

model Agence {
  id              String       @id @default(cuid())
  nom             String       @db.VarChar(150)
  slug            String       @unique @db.VarChar(100) // RG 1
  description     String?      @db.Text
  logoUrl         String?      @db.VarChar(500)
  couleurPrimaire String?      @db.VarChar(7)
  email           String?      @db.VarChar(191)
  telephone       String?      @db.VarChar(30)
  adresse         String?      @db.VarChar(255)
  ville           String?      @db.VarChar(100)
  pays            String?      @db.VarChar(100)
  devise          String       @default("MGA") @db.VarChar(3)
  // Identifiants fiscal et statistique, imprimés sur les factures (facultatifs).
  nif             String?      @db.VarChar(30)
  stat            String?      @db.VarChar(30)
  statut          StatutAgence @default(ACTIVE)
  createdAt       DateTime     @default(now())

  utilisateurs        Utilisateur[]
  guides              Guide[]
  circuits            Circuit[]
  etapes              Etape[]
  troncons            Troncon[]
  partenaires         Partenaire[]
  sessionsDepart      SessionDepart[]
  reservations        Reservation[]
  avis                Avis[]
  notifications       Notification[]
  journalActivites    JournalActivite[]
  itinerairesCalcules ItineraireCalcule[]
  abonnements         Abonnement[]
  conversations       Conversation[]
  appareilsMobiles    AppareilMobile[]
  itinerairesPerso    ItinerairePersonnalise[]
  departsSurMesure    DepartSurMesure[]
  blocages            Blocage[]
  signalements        Signalement[]
}

// ─── 2. Utilisateur ────────────────────────────────────────────────────────────

/// Origine d'un compte voyageur (après E12) : inscription en ligne ou ajout par l'agence.
enum OrigineClient {
  INSCRIPTION
  AGENCE
}

model Utilisateur {
  id                 String        @id @default(cuid())
  agenceId           String? // null uniquement pour SUPER_ADMIN
  nom                String        @db.VarChar(100)
  prenom             String        @db.VarChar(100)
  email              String        @db.VarChar(191)
  motDePasseHash     String        @db.VarChar(255)
  telephone          String?       @db.VarChar(30)
  // Présence et confidentialité (étape 5c) : dernière activité (site ou application), et
  // choix du voyageur : montrer qu'il est en ligne, recevoir des messages d'autres voyageurs.
  derniereActiviteAt DateTime?
  presenceVisible    Boolean       @default(true)
  messagesVoyageurs  Boolean       @default(true)
  // Photo de profil (après E12) : chemin d'un fichier envoyé (« /fichiers/avatars/… »).
  photoUrl           String?       @db.VarChar(255)
  role               Role
  actif              Boolean       @default(true)
  // Voyageur (rôle CLIENT) : inscrit lui-même sur le site ou l'application, ou ajouté par
  // l'agence (qui peut alors réserver pour lui). Sans objet pour le personnel.
  origine            OrigineClient @default(INSCRIPTION)
  dernierLoginAt     DateTime?
  createdAt          DateTime      @default(now())

  agence                 Agence?                  @relation(fields: [agenceId], references: [id], onDelete: Restrict)
  guide                  Guide?
  reservations           Reservation[]
  avis                   Avis[]
  notifications          Notification[]
  journalActivites       JournalActivite[]
  itinerairesCalcules    ItineraireCalcule[]
  conversations          Conversation[]           @relation("ConversationClient")
  conversationsRecues    Conversation[]           @relation("ConversationDestinataire")
  blocagesFaits          Blocage[]                @relation("BlocageAuteur")
  blocagesSubis          Blocage[]                @relation("BlocageCible")
  signalements           Signalement[]
  publications           Publication[]
  commentaires           Commentaire[]
  jaimes                 Jaime[]
  signalementsCommunaute SignalementCommunaute[]
  messages               Message[]
  lectures               LectureConversation[]
  jetonsReinitialisation JetonReinitialisation[]
  appareilsMobiles       AppareilMobile[]
  itinerairesRecus       ItinerairePersonnalise[] @relation("ItineraireClient")
  itinerairesCrees       ItinerairePersonnalise[] @relation("ItineraireAuteur")

  // RG 3. L'unicité de l'e-mail du personnel sur toute la plateforme (connexion via
  // /connexion) est vérifiée par l'application : MySQL n'a pas d'index unique partiel.
  @@unique([agenceId, email])
  @@index([email])
}

// ─── 3. Circuit ────────────────────────────────────────────────────────────────

model Circuit {
  id                 String            @id @default(cuid())
  agenceId           String
  titre              String            @db.VarChar(200)
  slug               String            @db.VarChar(200)
  resume             String?           @db.VarChar(500)
  description        String?           @db.Text
  difficulte         DifficulteCircuit
  dureeJours         Int
  distanceKm         Float? // cache, recalculé à partir des tronçons
  prixParPersonne    Int
  capaciteMax        Int
  imagePrincipaleUrl String?           @db.VarChar(500)
  statut             StatutCircuit     @default(BROUILLON)
  createdAt          DateTime          @default(now())

  agence              Agence              @relation(fields: [agenceId], references: [id], onDelete: Restrict)
  etapes              CircuitEtape[]
  partenaires         CircuitPartenaire[]
  sessionsDepart      SessionDepart[]
  avis                Avis[]
  itinerairesCalcules ItineraireCalcule[]

  @@unique([agenceId, slug])
  @@index([agenceId, statut])
}

// ─── 4. Etape (nœud du graphe) ─────────────────────────────────────────────────

model Etape {
  id          String    @id @default(cuid())
  agenceId    String
  nom         String    @db.VarChar(150)
  description String?   @db.Text
  type        TypeEtape
  latitude    Float
  longitude   Float
  altitudeM   Int?

  agence              Agence              @relation(fields: [agenceId], references: [id], onDelete: Restrict)
  tronconsDepart      Troncon[]           @relation("TronconDepart")
  tronconsArrivee     Troncon[]           @relation("TronconArrivee")
  circuits            CircuitEtape[]
  circuitPartenaires  CircuitPartenaire[]
  itinerairesDepartDe ItineraireCalcule[] @relation("ItineraireDepart")
  itinerairesArriveeA ItineraireCalcule[] @relation("ItineraireArrivee")

  @@index([agenceId])
}

// ─── 5. Troncon (arête du graphe) ──────────────────────────────────────────────

/// Mode de déplacement sur un tronçon (étape 8b).
enum ModeTroncon {
  MARCHE
  PIROGUE
}

/// Origine du tracé d'un tronçon (étape 6b-2).
enum SourceTrace {
  OSM // proposé par le calcul de trajet à pied d'OpenStreetMap, validé par l'agence
  MANUEL // dessiné ou corrigé à la main par l'agence
}

model Troncon {
  id              String  @id @default(cuid())
  agenceId        String
  etapeDepartId   String
  etapeArriveeId  String
  distanceKm      Float
  dureeMinutes    Int
  deniveleM       Int?
  difficulte      Int // 1 à 5
  bidirectionnel  Boolean @default(true)
  distanceEstimee Boolean @default(false) // true = Haversine × sinuosité, sans mesure terrain
  commentaire     String? @db.Text
  // Tracé réel du sentier (étape 6b-2) : points [longitude, latitude] du départ à l'arrivée,
  // proposé depuis les chemins d'OpenStreetMap ou dessiné par l'agence. Sans tracé, la carte
  // relie les deux étapes en ligne droite. N'intervient pas dans les algorithmes.
  trace           Json?
  traceSource     SourceTrace?
  // Mode de déplacement sur ce tronçon (étape 8b) : à pied, ou en pirogue (rivière, mer) ;
  // utilisé par la visite virtuelle. N'intervient pas dans les algorithmes.
  mode            ModeTroncon  @default(MARCHE)

  agence       Agence @relation(fields: [agenceId], references: [id], onDelete: Restrict)
  // RG 8 : une étape reliée par un tronçon ne peut pas être supprimée (Restrict).
  etapeDepart  Etape  @relation("TronconDepart", fields: [etapeDepartId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  etapeArrivee Etape  @relation("TronconArrivee", fields: [etapeArriveeId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([etapeDepartId, etapeArriveeId]) // RG 7
  @@index([agenceId])
  @@index([etapeArriveeId])
}

// ─── 6. CircuitEtape (liaison ordonnée) ────────────────────────────────────────

model CircuitEtape {
  id             String  @id @default(cuid())
  circuitId      String
  etapeId        String
  ordre          Int
  jour           Int?
  dureeSejourMin Int?
  notes          String? @db.Text

  circuit Circuit @relation(fields: [circuitId], references: [id], onDelete: Cascade)
  etape   Etape   @relation(fields: [etapeId], references: [id], onDelete: Restrict) // RG 8

  @@unique([circuitId, ordre]) // RG 4
  @@index([etapeId])
}

// ─── 7. SessionDepart (disponibilité) ──────────────────────────────────────────

model SessionDepart {
  id              String        @id @default(cuid())
  agenceId        String
  circuitId       String
  guideId         String?
  dateDebut       DateTime      @db.Date
  dateFin         DateTime      @db.Date
  placesTotal     Int
  prixParPersonne Int? // remplace le prix du circuit si renseigné
  statut          StatutSession @default(OUVERTE)
  notes           String?       @db.Text

  agence       Agence        @relation(fields: [agenceId], references: [id], onDelete: Restrict)
  circuit      Circuit       @relation(fields: [circuitId], references: [id], onDelete: Restrict)
  guide        Guide?        @relation(fields: [guideId], references: [id], onDelete: SetNull)
  reservations Reservation[]

  @@index([agenceId, dateDebut])
  @@index([circuitId])
  @@index([guideId])
}

// ─── 8. Reservation ────────────────────────────────────────────────────────────

model Reservation {
  id              String            @id @default(cuid())
  agenceId        String
  reference       String            @unique @db.VarChar(20) // lisible, ex. GT-2026-4F7K2Q
  clientId        String
  sessionId       String
  nombrePersonnes Int
  montantTotal    Int // figé à la création (RG 14)
  statut          StatutReservation @default(EN_ATTENTE)
  remarques       String?           @db.Text
  createdAt       DateTime          @default(now())
  confirmeeAt     DateTime?
  annuleeAt       DateTime?

  agence       Agence        @relation(fields: [agenceId], references: [id], onDelete: Restrict)
  client       Utilisateur   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  session      SessionDepart @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  participants Participant[]
  paiements    Paiement[]
  avis         Avis?
  publications Publication[]
  conversation Conversation?

  @@index([agenceId, statut])
  @@index([clientId])
  @@index([sessionId])
}

// ─── 9. Guide ──────────────────────────────────────────────────────────────────

model Guide {
  id               String  @id @default(cuid())
  agenceId         String
  utilisateurId    String? @unique // un guide peut ne pas avoir de compte
  nom              String  @db.VarChar(100)
  prenom           String  @db.VarChar(100)
  telephone        String? @db.VarChar(30)
  bio              String? @db.Text
  langues          Json // tableau de codes, ex. ["fr", "mg", "en"]
  experienceAnnees Int?
  actif            Boolean @default(true)

  agence         Agence          @relation(fields: [agenceId], references: [id], onDelete: Restrict)
  utilisateur    Utilisateur?    @relation(fields: [utilisateurId], references: [id], onDelete: SetNull)
  sessionsDepart SessionDepart[]
  departsSurMesure DepartSurMesure[]

  @@index([agenceId])
}

// ─── 10. Partenaire ────────────────────────────────────────────────────────────

model Partenaire {
  id             String         @id @default(cuid())
  agenceId       String
  nom            String         @db.VarChar(150)
  type           TypePartenaire
  description    String?        @db.Text
  telephone      String?        @db.VarChar(30)
  email          String?        @db.VarChar(191)
  adresse        String?        @db.VarChar(255)
  latitude       Float?
  longitude      Float?
  imageUrl       String?        @db.VarChar(500) // photo du site vitrine (ajout E8, hors §5.2)
  tarifIndicatif Int?
  actif          Boolean        @default(true)

  agence   Agence              @relation(fields: [agenceId], references: [id], onDelete: Restrict)
  circuits CircuitPartenaire[]

  @@index([agenceId])
}

// ─── 11. CircuitPartenaire (liaison N–N) ───────────────────────────────────────

model CircuitPartenaire {
  id             String  @id @default(cuid())
  circuitId      String
  partenaireId   String
  etapeId        String?
  prestation     String  @db.VarChar(200)
  prixUnitaire   Int?
  inclusDansPrix Boolean @default(true)

  circuit    Circuit    @relation(fields: [circuitId], references: [id], onDelete: Cascade)
  partenaire Partenaire @relation(fields: [partenaireId], references: [id], onDelete: Restrict)
  etape      Etape?     @relation(fields: [etapeId], references: [id], onDelete: Restrict)

  @@index([circuitId])
  @@index([partenaireId])
  @@index([etapeId])
}

// ─── 12. Participant ───────────────────────────────────────────────────────────

model Participant {
  id             String  @id @default(cuid())
  reservationId  String
  nom            String  @db.VarChar(100)
  prenom         String  @db.VarChar(100)
  age            Int?
  nationalite    String? @db.VarChar(100)
  contactUrgence String? @db.VarChar(191)

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId])
}

// ─── 13. Paiement (simulé) ─────────────────────────────────────────────────────

model Paiement {
  id               String          @id @default(cuid())
  reservationId    String
  montant          Int
  methode          MethodePaiement
  statut           StatutPaiement  @default(EN_ATTENTE)
  referenceExterne String?         @db.VarChar(100)
  payeLe           DateTime?

  // Une réservation qui a des paiements ne peut pas être supprimée (Restrict).
  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)

  @@index([reservationId])
}

// ─── 14. ItineraireCalcule (historique des calculs) ────────────────────────────

model ItineraireCalcule {
  id                String            @id @default(cuid())
  agenceId          String
  circuitId         String?
  // Nullables : l'historique est un instantané (le chemin complet est dans cheminJson)
  // et ne doit pas empêcher la suppression d'une étape.
  etapeDepartId     String?
  etapeArriveeId    String?
  algorithme        Algorithme
  critere           CritereItineraire
  alpha             Float
  beta              Float
  gamma             Float
  cheminJson        Json
  distanceTotaleKm  Float
  dureeTotaleMin    Int
  difficulteCumulee Float // sortie exigée au §6.3
  noeudsExplores    Int
  tempsCalculMs     Float
  creeParId         String?
  createdAt         DateTime          @default(now())

  agence        Agence                   @relation(fields: [agenceId], references: [id], onDelete: Restrict)
  circuit       Circuit?                 @relation(fields: [circuitId], references: [id], onDelete: SetNull)
  etapeDepart   Etape?                   @relation("ItineraireDepart", fields: [etapeDepartId], references: [id], onDelete: SetNull)
  etapeArrivee  Etape?                   @relation("ItineraireArrivee", fields: [etapeArriveeId], references: [id], onDelete: SetNull)
  creePar       Utilisateur?             @relation(fields: [creeParId], references: [id], onDelete: SetNull)
  personnalises ItinerairePersonnalise[]

  @@index([agenceId, createdAt])
  @@index([circuitId])
  @@index([etapeDepartId])
  @@index([etapeArriveeId])
  @@index([creeParId])
}

// ─── 15. Plan (fictif) ─────────────────────────────────────────────────────────

model Plan {
  id                 String  @id @default(cuid())
  code               String  @unique @db.VarChar(30)
  nom                String  @db.VarChar(100)
  prixMensuel        Int
  maxCircuits        Int
  maxUtilisateurs    Int
  maxSessionsActives Int
  fonctionnalites    Json
  actif              Boolean @default(true)

  abonnements Abonnement[]
}

// ─── 16. Abonnement (simulé) ───────────────────────────────────────────────────

model Abonnement {
  id                 String           @id @default(cuid())
  agenceId           String
  planId             String
  dateDebut          DateTime         @db.Date
  dateFin            DateTime?        @db.Date
  statut             StatutAbonnement
  renouvellementAuto Boolean          @default(false)

  agence Agence @relation(fields: [agenceId], references: [id], onDelete: Restrict)
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([agenceId])
  @@index([planId])
}

// ─── 17. Avis ──────────────────────────────────────────────────────────────────

model Avis {
  id            String     @id @default(cuid())
  agenceId      String
  circuitId     String
  reservationId String     @unique // RG 17 : un seul avis par réservation
  clientId      String
  note          Int // 1 à 5
  commentaire   String?    @db.Text
  statut        StatutAvis @default(EN_ATTENTE)
  createdAt     DateTime   @default(now())

  agence      Agence      @relation(fields: [agenceId], references: [id], onDelete: Restrict)
  circuit     Circuit     @relation(fields: [circuitId], references: [id], onDelete: Restrict)
  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  client      Utilisateur @relation(fields: [clientId], references: [id], onDelete: Restrict)

  @@index([agenceId, statut])
  @@index([circuitId])
  @@index([clientId])
}

// ─── 18. Notification (in-app) ─────────────────────────────────────────────────

model Notification {
  id            String   @id @default(cuid())
  agenceId      String?
  utilisateurId String
  type          String   @db.VarChar(50)
  titre         String   @db.VarChar(200)
  message       String   @db.Text
  lienUrl       String?  @db.VarChar(500)
  lue           Boolean  @default(false)
  createdAt     DateTime @default(now())

  agence      Agence?     @relation(fields: [agenceId], references: [id], onDelete: Restrict)
  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@index([agenceId])
  @@index([utilisateurId, lue])
}

// ─── 19. JournalActivite (audit) ───────────────────────────────────────────────

model JournalActivite {
  id            String   @id @default(cuid())
  agenceId      String?
  utilisateurId String?
  action        String   @db.VarChar(100)
  entite        String   @db.VarChar(50)
  entiteId      String?  @db.VarChar(30)
  details       Json?
  createdAt     DateTime @default(now())

  agence      Agence?      @relation(fields: [agenceId], references: [id], onDelete: Restrict)
  utilisateur Utilisateur? @relation(fields: [utilisateurId], references: [id], onDelete: SetNull)

  @@index([agenceId, createdAt])
  @@index([utilisateurId])
}

// ─── Messagerie (hors cahier des charges, ajoutée après E12 à la demande de l'étudiant) ─

// Conversation entre un client et l'agence (boîte partagée par l'administrateur et le
// personnel), éventuellement liée à une réservation (au plus une conversation par
// réservation). Le guide du départ de la réservation y participe.
model Conversation {
  id               String           @id @default(cuid())
  agenceId         String
  // Avec l'agence (voyageur ↔ équipe, guide) ou entre deux voyageurs (étape 5c : `clientId`
  // a ouvert la conversation, `destinataireId` est l'autre voyageur ; l'agence ne la lit pas).
  type             TypeConversation @default(AGENCE)
  clientId         String
  destinataireId   String?
  reservationId    String?          @unique
  sujet            String           @db.VarChar(200)
  dernierMessageAt DateTime         @default(now())
  createdAt        DateTime         @default(now())

  agence       Agence                @relation(fields: [agenceId], references: [id], onDelete: Restrict)
  client       Utilisateur           @relation("ConversationClient", fields: [clientId], references: [id], onDelete: Restrict)
  destinataire Utilisateur?          @relation("ConversationDestinataire", fields: [destinataireId], references: [id], onDelete: Restrict)
  reservation  Reservation?          @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  messages     Message[]
  lectures     LectureConversation[]

  @@index([agenceId, dernierMessageAt])
  @@index([clientId])
  @@index([destinataireId])
}

// Message d'une conversation (texte seul, pas de pièce jointe). Hérite de l'agence de la
// conversation.
model Message {
  id             String   @id @default(cuid())
  conversationId String
  auteurId       String
  contenu        String   @db.Text
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  auteur       Utilisateur  @relation(fields: [auteurId], references: [id], onDelete: Restrict)

  @@index([conversationId, createdAt])
  @@index([auteurId])
}

// Jusqu'où chaque utilisateur a lu une conversation (messages non lus = messages plus
// récents que `luJusqua`, écrits par quelqu'un d'autre).
model LectureConversation {
  id             String   @id @default(cuid())
  conversationId String
  utilisateurId  String
  luJusqua       DateTime

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  utilisateur  Utilisateur  @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@unique([conversationId, utilisateurId])
  @@index([utilisateurId])
}

// ─── Réinitialisation du mot de passe (hors cahier des charges, après E12) ────────

// Lien « mot de passe oublié » envoyé par e-mail. Seule l'EMPREINTE (SHA-256) du jeton est
// conservée : une fuite de la base ne permet pas de réinitialiser un compte. Valable 1 heure,
// utilisable une seule fois.
model JetonReinitialisation {
  id            String    @id @default(cuid())
  utilisateurId String
  empreinte     String    @unique @db.Char(64)
  expireAt      DateTime
  utiliseAt     DateTime?
  createdAt     DateTime  @default(now())

  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@index([utilisateurId, createdAt])
}

// ─── Application mobile : téléphones à prévenir (hors cahier des charges, après E12) ──

// Jeton de notification push (service Expo) d'un téléphone où un voyageur est connecté.
// Enregistré à la connexion dans l'application, retiré à la déconnexion ou quand le
// service répond que l'application a été désinstallée. Un même téléphone peut servir à
// deux comptes de deux agences : unicité par agence.
model AppareilMobile {
  id            String   @id @default(cuid())
  agenceId      String
  utilisateurId String
  expoPushToken String   @db.VarChar(255)
  plateforme    String   @db.VarChar(20)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  agence      Agence      @relation(fields: [agenceId], references: [id], onDelete: Restrict)
  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@unique([agenceId, expoPushToken])
  @@index([utilisateurId])
}

// ─── Itinéraires sur mesure (hors cahier des charges, après E12) ──────────────────

/// Qui a composé l'itinéraire : l'agence (proposition à un client) ou le voyageur (demande).
enum OrigineItineraire {
  AGENCE
  CLIENT
}

enum StatutItineraire {
  EN_ATTENTE
  ACCEPTE
  DECLINE
}

// Itinéraire sur mesure entre des villages du réseau de l'agence, pour UN client : proposé par
// l'agence, ou demandé par le voyageur. Le tracé n'est pas recopié : il vient du calcul
// enregistré dans l'historique (ItineraireCalcule, instantané du chemin), qui reste ainsi la
// trace unique de chaque calcul (mémoire, §6.3).
model ItinerairePersonnalise {
  id                  String            @id @default(cuid())
  agenceId            String
  clientId            String
  creeParId           String
  itineraireCalculeId String
  origine             OrigineItineraire
  titre               String            @db.VarChar(150)
  message             String?           @db.Text
  statut              StatutItineraire  @default(EN_ATTENTE)
  reponse             String?           @db.Text
  reponduAt           DateTime?
  createdAt           DateTime          @default(now())

  agence     Agence            @relation(fields: [agenceId], references: [id], onDelete: Restrict)
  client     Utilisateur       @relation("ItineraireClient", fields: [clientId], references: [id], onDelete: Restrict)
  creePar    Utilisateur       @relation("ItineraireAuteur", fields: [creeParId], references: [id], onDelete: Restrict)
  itineraire ItineraireCalcule @relation(fields: [itineraireCalculeId], references: [id], onDelete: Restrict)
  departs    DepartSurMesure[]

  @@index([agenceId, createdAt])
  @@index([clientId])
  @@index([creeParId])
  @@index([itineraireCalculeId])
}

// ─── Voyageurs entre eux, signalements (hors cahier des charges, étape 5c) ─────────

enum TypeConversation {
  AGENCE
  VOYAGEURS
}

// Un voyageur en bloque un autre : plus aucun message dans les deux sens.
model Blocage {
  id         String   @id @default(cuid())
  agenceId   String
  bloqueurId String
  bloqueId   String
  createdAt  DateTime @default(now())

  agence   Agence      @relation(fields: [agenceId], references: [id], onDelete: Restrict)
  bloqueur Utilisateur @relation("BlocageAuteur", fields: [bloqueurId], references: [id], onDelete: Cascade)
  bloque   Utilisateur @relation("BlocageCible", fields: [bloqueId], references: [id], onDelete: Cascade)

  @@unique([bloqueurId, bloqueId])
  @@index([agenceId])
  @@index([bloqueId])
}

/// Ce qui est signalé : un message privé (5c), une publication ou un commentaire (5d).
enum CibleSignalement {
  MESSAGE
  PUBLICATION
  COMMENTAIRE
}

enum StatutSignalement {
  OUVERT
  TRAITE
}

// Signalement d'un message privé entre voyageurs, traité par l'agence (cible MESSAGE).
// Les publications et commentaires de la communauté sont signalés dans SignalementCommunaute.
// `cibleId` désigne la ligne signalée (pas de clé étrangère : la cible varie).
model Signalement {
  id        String            @id @default(cuid())
  agenceId  String
  auteurId  String
  cible     CibleSignalement
  cibleId   String            @db.VarChar(30)
  motif     String?           @db.Text
  statut    StatutSignalement @default(OUVERT)
  createdAt DateTime          @default(now())
  traiteAt  DateTime?

  agence Agence      @relation(fields: [agenceId], references: [id], onDelete: Restrict)
  auteur Utilisateur @relation(fields: [auteurId], references: [id], onDelete: Cascade)

  @@unique([auteurId, cible, cibleId])
  @@index([agenceId, statut])
}

// ─── Communauté (étape 5d) ───────────────────────────────────────────────────────
// Tables de la PLATEFORME (sans agenceId) : le fil est commun à toutes les agences et
// modéré par le super admin. Interdites au client confiné d'une agence (portée
// « platform » du helper tenant) ; accès par src/lib/services/communaute.ts uniquement.

enum StatutContenu {
  VISIBLE
  MASQUE
}

// Publication d'un voyageur après un séjour terminé (la réservation le prouve).
model Publication {
  id            String        @id @default(cuid())
  auteurId      String
  reservationId String
  legende       String?       @db.Text
  // Adresses « /fichiers/publications/<uuid>.webp », dans l'ordre (1 à 4).
  photos        Json
  statut        StatutContenu @default(VISIBLE)
  createdAt     DateTime      @default(now())
  masqueAt      DateTime?

  auteur       Utilisateur   @relation(fields: [auteurId], references: [id], onDelete: Cascade)
  reservation  Reservation   @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  commentaires Commentaire[]
  jaimes       Jaime[]

  @@index([statut, createdAt])
  @@index([auteurId])
  @@index([reservationId])
}

model Commentaire {
  id            String        @id @default(cuid())
  publicationId String
  auteurId      String
  contenu       String        @db.Text
  statut        StatutContenu @default(VISIBLE)
  createdAt     DateTime      @default(now())

  publication Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  auteur      Utilisateur @relation(fields: [auteurId], references: [id], onDelete: Cascade)

  @@index([publicationId, createdAt])
  @@index([auteurId])
}

// « J'aime » : un par voyageur et par publication.
model Jaime {
  publicationId String
  utilisateurId String
  createdAt     DateTime @default(now())

  publication Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@id([publicationId, utilisateurId])
  @@index([utilisateurId])
}

// Signalement d'une publication ou d'un commentaire, traité par le super admin.
model SignalementCommunaute {
  id        String            @id @default(cuid())
  auteurId  String
  cible     CibleSignalement
  cibleId   String            @db.VarChar(30)
  motif     String?           @db.Text
  statut    StatutSignalement @default(OUVERT)
  createdAt DateTime          @default(now())
  traiteAt  DateTime?

  auteur Utilisateur @relation(fields: [auteurId], references: [id], onDelete: Cascade)

  @@unique([auteurId, cible, cibleId])
  @@index([statut, createdAt])
}

// Départ d'un itinéraire sur mesure (étape 9, demande de l'étudiant) : une fois l'itinéraire
// accepté, le voyageur programme ses dates et le nombre de personnes ; l'agence confirme
// (tarif, guide, message) ou refuse. Un seul départ actif (DEMANDE ou CONFIRME) par itinéraire ;
// les départs refusés ou annulés restent en historique. Le paiement se règle avec l'agence.
model DepartSurMesure {
  id              String                @id @default(cuid())
  agenceId        String
  itineraireId    String
  guideId         String?
  dateDebut       DateTime              @db.Date
  dateFin         DateTime              @db.Date
  nombrePersonnes Int
  remarques       String?               @db.Text
  statut          StatutDepartSurMesure @default(DEMANDE)
  /// Tarif total indiqué par l'agence à la confirmation (devise de l'agence), facultatif.
  tarif           Int?
  reponse         String?               @db.Text
  reponduAt       DateTime?
  annuleAt        DateTime?
  createdAt       DateTime              @default(now())

  agence     Agence                 @relation(fields: [agenceId], references: [id], onDelete: Restrict)
  itineraire ItinerairePersonnalise @relation(fields: [itineraireId], references: [id], onDelete: Cascade)
  guide      Guide?                 @relation(fields: [guideId], references: [id], onDelete: SetNull)

  @@index([agenceId, dateDebut])
  @@index([itineraireId])
  @@index([guideId])
}

enum StatutDepartSurMesure {
  DEMANDE
  CONFIRME
  REFUSE
  ANNULE
}
